<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic ALTO 4 fixture for tests/test_alto_tools.py.
  Exercises the @IDNEXT chain (B1 -> B3 -> B2, against a document order of
  B1, B2, B3) plus the <Glyph>, <Illustration> and <GraphicalElement> counters,
  none of which any data_samples/ file contains.
-->
<alto xmlns="http://www.loc.gov/standards/alto/ns-v4#">
  <Layout>
    <Page ID="P1">
      <PrintSpace>
        <TextBlock ID="B1" IDNEXT="B3">
          <TextLine ID="L1"><String ID="S1" CONTENT="alpha"/></TextLine>
        </TextBlock>
        <TextBlock ID="B2">
          <TextLine ID="L2"><String ID="S2" CONTENT="gamma"/><Glyph ID="G1" CONTENT="g"/></TextLine>
        </TextBlock>
        <TextBlock ID="B3" IDNEXT="B2">
          <TextLine ID="L3"><String ID="S3" CONTENT="beta"/></TextLine>
        </TextBlock>
        <Illustration ID="I1" HEIGHT="10" WIDTH="10" VPOS="0" HPOS="0"/>
        <GraphicalElement ID="GE1" HEIGHT="5" WIDTH="5" VPOS="1" HPOS="1"/>
      </PrintSpace>
    </Page>
  </Layout>
</alto>
