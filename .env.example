# Image tag used by docker-compose (matches para_config.txt [tool] version on release)
ATRIUM_VERSION=dev
# Stamped into paradata as runner_ref (defaults to "dev")
ATRIUM_RUNNER_REF=dev
# CORS for the api profile
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500
# Port the api service binds, and the port service/healthcheck.py probes inside the
# container. Changing it here moves the listener, the published port and the container's
# own HEALTHCHECK together, because docker-compose.yml maps "${PORT:-8000}:${PORT:-8000}".
PORT=8000
# Bind address. Leave at 0.0.0.0: healthcheck.py always probes loopback and never reads
# HOST, so 127.0.0.1 gives a container that reports healthy and is unreachable from
# outside it.
HOST=0.0.0.0
# Seconds uvicorn waits for in-flight requests on SIGTERM. Raise together with the
# deployment's grace period (see docs/k8s_deployment.md in the hub).
GRACEFUL_SHUTDOWN_S=20
