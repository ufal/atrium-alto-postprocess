[run]
source = .
omit =
    tests/*
    setup/*
    venv/*
    .venv/*
    *_paradata.py
    para_licenses.py

[report]
# Ratchet: set ~2 points below the measured fast-lane baseline of 63.11%
# (2026-08-19, issue atrium-project#10). Raised from 59.
#
# `service/*` was in the omit list above until this round, which mattered because BOTH
# of this repo's P0s lived in service/text_api.py -- the /process endpoint merging a key
# no path returns, and the lower-cased Path.stem re-keying baselines. The ratchet could
# not have protected the one directory whose defects had already shipped.
#
# The correction worth recording: un-omitting was expected to CRATER the number, and it
# raised it (61.63% -> 63.11%). service/ was never untested -- the api-contract and
# document_json suites cover it at 61-89% -- it was tested code hidden from the report.
# The blind spot was the ratchet's, not the suite's.
fail_under = 61
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    pass
    except ImportError:
